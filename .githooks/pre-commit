#!/bin/sh
# Governança de capacidades: commit com arquivo frontend exige evidência válida de
# Modern Web Guidance e frontend-design nesta worktree e branch (scripts/capacidades.py).
# Ligar uma vez por clone: git config core.hooksPath .githooks
PY=$(command -v python3 || command -v python || command -v py)
[ -n "$PY" ] || { echo "pre-commit: Python não encontrado" >&2; exit 1; }
exec "$PY" scripts/capacidades.py pre-commit
